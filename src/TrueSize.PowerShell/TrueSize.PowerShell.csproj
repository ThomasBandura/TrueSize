<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Binary module for PowerShell 7.6+ (7.6 runs on .NET 10, 7.7 on .NET 11).
    Compiled against SMA 7.6 so the module loads in both. SMA is provided by the host and never shipped.
  -->

  <PropertyGroup>
    <AssemblyName>TrueSize.PowerShell</AssemblyName>
    <RootNamespace>TrueSize.PowerShell</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management.Automation" Version="7.6.10" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrueSize.Core\TrueSize.Core.csproj" />
    <!-- Build order only: the helper executable is copied into the module folder below. -->
    <ProjectReference Include="..\TrueSize.ScanHelper\TrueSize.ScanHelper.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- Ship TrueSize.ScanHelper next to the module: used when raw volume reads are blocked in the PowerShell process. -->
  <Target Name="CopyScanHelper" AfterTargets="Build">
    <ItemGroup>
      <ScanHelperFiles Include="..\TrueSize.ScanHelper\bin\$(Configuration)\$(TargetFramework)\TrueSize.ScanHelper.exe;..\TrueSize.ScanHelper\bin\$(Configuration)\$(TargetFramework)\TrueSize.ScanHelper.dll;..\TrueSize.ScanHelper\bin\$(Configuration)\$(TargetFramework)\TrueSize.ScanHelper.runtimeconfig.json;..\TrueSize.ScanHelper\bin\$(Configuration)\$(TargetFramework)\TrueSize.ScanHelper.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(ScanHelperFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <None Update="TrueSize.psd1" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TrueSize.Format.ps1xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
