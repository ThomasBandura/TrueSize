<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="TrueSize.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HighContrastAdjustment="None">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Column widths shared by the header and the rows. -->
            <GridLength x:Key="SizeColumnWidth">104</GridLength>
            <GridLength x:Key="ShareColumnWidth">164</GridLength>
            <GridLength x:Key="FilesColumnWidth">96</GridLength>
            <GridLength x:Key="MarkersColumnWidth">72</GridLength>
        </ResourceDictionary>
    </Application.Resources>
</Application>
